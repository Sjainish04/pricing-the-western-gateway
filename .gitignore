# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
*.egg-info/

# Node
node_modules/

# Build output. Vercel builds the frontend from source
# (`npm run build --prefix frontend`), so the bundle does not belong in git.
frontend/dist/

# Editors and OS
.DS_Store
.idea/
.vscode/
*.swp

# Local tooling
.playwright-mcp/

# NOT ignored, deliberately: backend/data/precomputed/
# Those six JSON files are the deploy cache. They are generated by
# scripts/precompute.py, committed on purpose, and served in production because
# the endpoints behind them exceed Vercel's function timeout. Each one carries a
# hash of the full model config and is refused if the running config differs, so
# a stale file makes the API slower rather than wrong. See README, "Deploying".
